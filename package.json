{
  "name": "automerge",
  "version": "1.0.0",
  "description": "Collaborative markdown editor demo using Automerge",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=public/app.js",
    "start": "esbuild src/main.js --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js --servedir=public --serve=8000",
    "test": "node test/index.test.js && node test/sync.test.js"
  },
  "type": "module",
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "^2.5.6",
    "@automerge/automerge-repo-network-websocket": "^2.5.6",
    "@automerge/automerge-repo-storage-indexeddb": "^2.5.6",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true
}
